[agent]
# Project-level config is loaded from .zx-code/config.toml.
# User-level config is loaded from ~/.zx-code/config.toml.
# CLI options override both.
# Security note: project config can tighten user policy, but cannot grant trust,
# widen capabilities/roots, or replace model/embedding endpoints.

[agent.model]
name = "openai/gpt-5.4-mini"
fallback_models = "openai/gpt-5.5"
reasoning_effort = "" # supported values depend on the model/provider, e.g. "low", "medium", "high"
max_iterations = 30
timeout_s = 300.0
stream = true
render_markdown = true
markdown_streaming = true

# Named profiles, API-key environment selection, and custom endpoints are
# authority settings. Define them in ~/.zx-code/config.toml as [[model.profiles]],
# not in project config. Project config may still select model.name above.

# For an OpenAI-compatible Chat Completions endpoint, set base_url here.
# If the endpoint only supports /responses, config alone is not enough.
# [[model.profiles]]  # user config only
# name = "custom"
# model = "openai/gpt-5.4-mini"
# api_key_env = "CUSTOM_API_KEY"
# extra_kwargs = { base_url = "https://example.com/v1" }

[agent.context]
max_tokens = 128000
keep_recent = 15
tool_result_max_chars = 6000
compact_model = ""
output_reserve_tokens = 8192
retrieval_top_k = 3
retrieval_max_tokens = 1200

[agent.state]
session_id = "default"
data_dir = ".zx-code/state"
memory_path = ".zx-code/state/memory/MEMORY.md"
enable_memory = true
enable_skills = true
skills_dir = "skills"
enable_todos = true
enable_tasks = true
tasks_dir = ".zx-code/state/tasks"

[agent.permissions]
default = "allow"
rules_path = ""

[agent.permissions.tools]
# bash = "ask"
# edit = "allow"

[agent.security]
# Project config may only tighten these authority limits. Put workspace_trust =
# "trusted" and any capability grants in ~/.zx-code/config.toml, not here.
workspace_trust = "untrusted"
read_roots = ["."]
write_roots = ["."]

[agent.security.capabilities]
# shell = "deny"
# network = "deny"
# mcp = "deny"
# plugin = "deny"
# hook = "deny"

[agent.subagents]
enabled = true
max_depth = 1

[agent.worktree]
isolation_enabled = false
dir = ".zx-code/state/worktrees"

[agent.debug]
log_enabled = false
log_path = ".zx-code/logs/debug.jsonl"

[agent.trace]
enabled = false
dir = ".zx-code/logs/traces"
sanitize = true
html = false
html_include_raw_response = false

[agent.extensions]
hooks_path = ""
plugin_dirs = []

# Optional MCP server example.
# [[agent.extensions.mcp_servers]]
# name = "filesystem"
# command = "python"
# args = ["./mcp_servers/filesystem_server.py"]
# env = { TOKEN = "env-or-placeholder-only" }
